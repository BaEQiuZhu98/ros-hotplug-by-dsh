<?xml version="1.0"?>
<robot name="BiAdaptRobot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find biadapt_description)/urdf/base.xacro" />
    <xacro:include filename="$(find biadapt_description)/urdf/body.xacro" />
    <xacro:include filename="$(find biadapt_description)/urdf/wheel.xacro" />
    <xacro:include filename="$(find biadapt_description)/urdf/sensor.xacro" />
    <xacro:include filename="$(find biadapt_description)/urdf/arm.xacro" />
    <xacro:include filename="$(find biadapt_description)/urdf/debug.xacro" />

    <xacro:property name="base_size_length" value="0.5" />
    <xacro:property name="base_size_width" value="0.4" />
    <xacro:property name="base_size_height" value="0.12" />
    <xacro:property name="base_mass" value="2" />

    <xacro:property name="torso_size_length" value="0.3" />
    <xacro:property name="torso_size_width" value="0.3" />
    <xacro:property name="torso_size_height" value="0.8" />
    <xacro:property name="torso_mass" value="6" />

    <xacro:property name="head_size_length" value="0.2" />
    <xacro:property name="head_size_width" value="0.2" />
    <xacro:property name="head_size_height" value="0.1" />
    <xacro:property name="head_mass" value="1" />

    <xacro:property name="wheel_radius" value="0.075" />
    <xacro:property name="wheel_width" value="0.03" />
    <xacro:property name="wheel_mass" value="1" />
    <xacro:property name="wheel_joint_parent" value="base_link" />

    <xacro:property name="caster_wheel_radius" value="0.03" />
    <xacro:property name="caster_wheel_mass" value="0.2" />
    <xacro:property name="caster_wheel_joint_parent" value="base_link" />

    <xacro:arg name="debug_enable" default="false" />

    <!-- 底盘 -->
    <xacro:base
        base_size_length="${base_size_length}"
        base_size_width="${base_size_width}"
        base_size_height="${base_size_height}"
        base_mass="${base_mass}"
        above_ground="${base_size_height/2 + wheel_radius}" />

    <!-- 躯干 -->
    <xacro:box
        prefix="torso"
        box_size_length="${torso_size_length}"
        box_size_width="${torso_size_width}"
        box_size_height="${torso_size_height}"
        box_mass="${torso_mass}"
        joint_parent="base_link"
        joint_origin_xyz="0 0 ${base_size_height/2 + torso_size_height/2}" />

    <!-- 头部 + 激光雷达 + RGB-D相机 -->
    <xacro:box
        prefix="head"
        box_size_length="${head_size_length}"
        box_size_width="${head_size_width}"
        box_size_height="${head_size_height}"
        box_mass="${head_mass}"
        joint_parent="torso_link"
        joint_origin_xyz="0 0 ${torso_size_height/2 + head_size_height/2}" />
    <xacro:gpu_lidar
        prefix="head"
        gazebo_ref="head_link"
        pose="0 0 ${head_size_height/2} 0 0 0"
        gz_frame_id="head_link" />
    <xacro:rgbd_camera
        prefix="head"
        gazebo_ref="head_link"
        pose="0 0 ${head_size_height/2} 0 0 0"
        gz_frame_id="head_link" />

    <!-- 驱动轮 左 + 右 -->
    <xacro:wheel
        prefix="left"
        reflect="1"
        wheel_radius="${wheel_radius}"
        wheel_width="${wheel_width}"
        wheel_mass="${wheel_mass}"
        joint_parent="${wheel_joint_parent}"
        joint_origin_xyz="${-base_size_length/2+wheel_radius} ${base_size_width/2} ${-base_size_height/2}" />

    <xacro:wheel
        prefix="right"
        reflect="-1"
        wheel_radius="${wheel_radius}"
        wheel_width="${wheel_width}"
        wheel_mass="${wheel_mass}"
        joint_parent="${wheel_joint_parent}"
        joint_origin_xyz="${-base_size_length/2+wheel_radius} ${-base_size_width/2} ${-base_size_height/2}" />

    <!-- 从动轮(万向轮) -->
    <xacro:caster_wheel
        prefix="front"
        caster_wheel_radius="${caster_wheel_radius}"
        caster_wheel_mass="${caster_wheel_mass}"
        joint_parent="${caster_wheel_joint_parent}"
        joint_origin_xyz="${base_size_length/2-caster_wheel_radius} 0 ${-base_size_height/2 - wheel_radius + caster_wheel_radius}" />

    <!-- 双臂 左 + 右 -->
    <xacro:arm
        prefix="left"
        parent="torso_link"
        ur_type="ur3"
    >
        <origin xyz="0 ${torso_size_width/2} ${torso_size_height/4}" rpy="0 ${PI/2} ${PI/2}" />
    </xacro:arm>

    <xacro:arm
        prefix="right"
        parent="torso_link"
        ur_type="ur3"
    >
        <origin xyz="0 ${-torso_size_width/2} ${torso_size_height/4}" rpy="0 ${PI/2} ${-PI/2}" />
    </xacro:arm>

    <!-- 手指 -->
    <xacro:gripper prefix="left" />
    <xacro:gripper prefix="right" />

    <!-- gazebo 配置 -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find biadapt_description)/config/biadapt_controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ros2_control 配置 -->
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:wheel_joint_control prefix="left" />
        <xacro:wheel_joint_control prefix="right" />
        <xacro:arm_joint_control prefix="left" />
        <xacro:arm_joint_control prefix="right" />
        <xacro:gripper_joint_control prefix="left" />
        <xacro:gripper_joint_control prefix="right" />
    </ros2_control>

    <!-- debug配置 -->
    <xacro:if value="$(arg debug_enable)">
        <!-- gazebo手动控制GUI -->
        <xacro:debug_joint_ctrl_all />
    </xacro:if>
</robot>