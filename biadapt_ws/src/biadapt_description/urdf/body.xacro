<?xml version="1.0"?>
<robot name="BiAdaptRobot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find biadapt_description)/urdf/base.xacro" />

    <xacro:macro name="base"
        params="base_size_length base_size_width base_size_height base_mass above_ground">
        <link name="base_footprint" />
        <link name="base_link">
            <visual>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${base_size_length} ${base_size_width} ${base_size_height}" />
                </geometry>
                <material name="grey">
                    <color rgba="${color_titanium_grey}" />
                </material>
            </visual>
            <collision>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${base_size_length} ${base_size_width} ${base_size_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <mass value="${base_mass}" />
                <inertia
                    ixx="${base_mass*(base_size_width*base_size_width+base_size_height*base_size_height)/12}"
                    ixy="0.0" ixz="0.0"
                    iyy="${base_mass*(base_size_length*base_size_length+base_size_height*base_size_height)/12}"
                    iyz="0.0"
                    izz="${base_mass*(base_size_length*base_size_length+base_size_width*base_size_width)/12}" />
            </inertial>
        </link>
        <joint name="base_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <origin xyz="0 0 ${above_ground}" rpy="0 0 0" />
        </joint>
        <gazebo reference="base_link">
            <material>Gazebo/Grey</material>
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="torso"
        params="torso_size_length torso_size_width torso_size_height torso_mass joint_origin_xyz">
        <link name="torso_link">
            <visual>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${torso_size_length} ${torso_size_width} ${torso_size_height}" />
                </geometry>
                <material name="grey">
                    <color rgba="${color_titanium_grey}" />
                </material>
            </visual>
            <collision>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${torso_size_length} ${torso_size_width} ${torso_size_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <mass value="${torso_mass}" />
                <inertia
                    ixx="${torso_mass*(torso_size_width*torso_size_width+torso_size_height*torso_size_height)/12}"
                    ixy="0.0" ixz="0.0"
                    iyy="${torso_mass*(torso_size_length*torso_size_length+torso_size_height*torso_size_height)/12}"
                    iyz="0.0"
                    izz="${torso_mass*(torso_size_length*torso_size_length+torso_size_width*torso_size_width)/12}" />
            </inertial>
        </link>
        <joint name="torso_joint" type="fixed">
            <parent link="base_link" />
            <child link="torso_link" />
            <origin xyz="${joint_origin_xyz}" rpy="0 0 0" />
        </joint>
        <gazebo reference="torso_link">
            <material>Gazebo/Grey</material>
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>
</robot>