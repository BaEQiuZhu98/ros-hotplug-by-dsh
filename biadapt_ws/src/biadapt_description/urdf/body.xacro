<?xml version="1.0"?>
<robot name="BiAdaptRobot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find biadapt_description)/urdf/base.xacro" />

    <xacro:macro name="base"
        params="base_size_length base_size_width base_size_height base_mass above_ground">
        <link name="base_footprint" />
        <link name="base_link">
            <visual>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${base_size_length} ${base_size_width} ${base_size_height}" />
                </geometry>
                <material name="grey">
                    <color rgba="${color_titanium_grey}" />
                </material>
            </visual>
            <collision>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${base_size_length} ${base_size_width} ${base_size_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <mass value="${base_mass}" />
                <xacro:box_inertia
                    x="${base_size_length}"
                    y="${base_size_width}"
                    z="${base_size_height}"
                    m="${base_mass}" />
            </inertial>
        </link>
        <joint name="base_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <origin xyz="0 0 ${above_ground}" rpy="0 0 0" />
        </joint>
        <gazebo reference="base_link">
            <material>Gazebo/Grey</material>
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="box"
        params="prefix box_size_length box_size_width box_size_height box_mass joint_parent joint_origin_xyz">
        <link name="${prefix}_link">
            <visual>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${box_size_length} ${box_size_width} ${box_size_height}" />
                </geometry>
                <material name="grey">
                    <color rgba="${color_titanium_grey}" />
                </material>
            </visual>
            <collision>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <geometry>
                    <box size="${box_size_length} ${box_size_width} ${box_size_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="${base_point}" rpy="${base_point}" />
                <mass value="${box_mass}" />
                <xacro:box_inertia
                    x="${box_size_length}"
                    y="${box_size_width}"
                    z="${box_size_height}"
                    m="${box_mass}" />
            </inertial>
        </link>
        <joint name="${prefix}_joint" type="fixed">
            <parent link="${joint_parent}" />
            <child link="${prefix}_link" />
            <origin xyz="${joint_origin_xyz}" rpy="0 0 0" />
        </joint>
        <gazebo reference="${prefix}_link">
            <material>Gazebo/Grey</material>
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>
</robot>