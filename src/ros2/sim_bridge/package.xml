<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_bridge</name>
  <version>0.1.0</version>
  <description>MuJoCo two-arm simulator bridge: subscribes tool_config/touch_command/ball_position/move_to/home_command/reset_command, publishes joint_state (contract v1.2)</description>
  <maintainer email="1095897362@qq.com">BaEQiuZhu98</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- mujoco/numpy 不进 rosdep: 由项目 venv(/root/venvs/robo) 提供, 见 src/README.zh.md. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
